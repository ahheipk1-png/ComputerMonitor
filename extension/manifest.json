{
  "manifest_version": 3,
  "name": "ComputerMonitor Tab Tracker",
  "version": "1.0.0",
  "description": "Reports active Chrome/Edge browser tabs to ComputerMonitor and enables remote tab closing.",
  "key": "",
  "update_url": "http://127.0.0.1:5500/extension/updates.xml",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5500/*",
    "http://localhost:5500/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
